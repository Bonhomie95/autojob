# ============================================================
#  AutoJob — environment variables
#
#  Almost everything is configured in the DASHBOARD (Settings page +
#  the "Connect your email" card) and stored in the DATABASE — not here.
#  A deployed user never edits this file.
#
#  These are the ONLY things you might set as environment variables.
#  On Render: set DATABASE_URL (required) and APP_BASE_URL. The optional
#  API keys below are the only settings with no dashboard UI.
# ============================================================

# Database.
#   On Render: a Postgres connection string (the render.yaml wires this up).
#   Locally: leave blank to use the SQLite file named in DB_PATH.
DATABASE_URL=
DB_PATH=jobhunter.db

# Your public URL — makes LinkedIn share cards point at the right place.
# e.g. https://your-app.onrender.com   (leave blank to auto-detect)
APP_BASE_URL=

# ── Optional API keys (no dashboard UI) — leave blank to skip ──
# AI polish for your very top matches:
GROQ_API_KEY=
# Recruiter-email enrichment (any you have; all optional):
HUNTER_API_KEY=
PROSPEO_API_KEY=
REOON_API_KEY=
MILLION_VERIFIER_API_KEY=
# GitHub enrichment for CV bullets:
GITHUB_TOKEN=

# Optional: only keeps login-less browser sessions stable across restarts.
# Not required — leave blank and the app generates one per process.
SECRET_KEY=
