# ============================================================
#  AutoJob (multi-tenant SaaS) — environment variables
#
#  These configure the APPLICATION (same for every user). Per-user settings —
#  each person's CV, API keys, and email sender — are configured in the app UI
#  and stored (encrypted) in the database, never here.
#
#  Local dev: copy to .env. Only APP_ENV is really needed; the rest have safe
#  local defaults (SQLite, a dev secret, no encryption requirement).
#  Production (Render): see render.yaml — SECRET_KEY, DATABASE_URL, and
#  CREDENTIAL_ENCRYPTION_KEY are required and the app refuses to boot without them.
# ============================================================

# Which config to load: development | testing | production
APP_ENV=development

# ── Core (required in production) ──────────────────────────
# Flask session/CSRF signing key. MUST be stable and secret in production.
SECRET_KEY=dev-insecure-change-me

# Database. Blank locally = a SQLite file. In production set a Postgres URL.
#   postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Fernet key encrypting each user's SMTP password + API keys at rest.
# Required in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── File storage ───────────────────────────────────────────
# Uploaded CVs + generated packages. 'local' keeps them on disk.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=storage

# ── Optional: platform-managed API key pools ───────────────
# Comma-separated. When set, users who don't bring their own keys fall back to
# these, so they can "just upload a CV". Leave blank to require BYO keys.
MANAGED_GROQ_KEYS=
MANAGED_HUNTER_KEYS=
MANAGED_PROSPEO_KEYS=
MANAGED_REOON_KEYS=
MANAGED_MILLION_KEYS=

# ── Optional: scale-out with Celery (advanced) ─────────────
# Default is a single web service with in-process background runs (no Redis).
# To run a separate Celery worker instead, set RUN_VIA_CELERY=true, point
# REDIS_URL at a broker, and run: celery -A autojob.celery_app.celery worker
RUN_VIA_CELERY=false
REDIS_URL=redis://localhost:6379/0

# ── Optional: observability ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=false
