# Base URL of the deployed backend API, e.g. https://autojob.onrender.com
# Leave unset for local dev — Vite proxies /api to http://127.0.0.1:9000
# (see vite.config.ts), so requests stay same-origin and no CORS is needed.
# Vite only exposes env vars prefixed VITE_, and only at build time — set
# this in Vercel's project settings (Environment Variables) before deploying.
VITE_API_BASE_URL=
