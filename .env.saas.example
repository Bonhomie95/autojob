# ─────────────────────────────────────────────────────────────
# AutoJob SaaS — application (not per-user) configuration.
#
# Per-user settings (their CV, API keys, sending identity) live in the
# database from Phase 4 on — they do NOT belong here. This file holds only
# what is the same for the whole deployment.
# ─────────────────────────────────────────────────────────────

# development | testing | production
APP_ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me

# Database. SQLite for local dev; Postgres in production.
#   Postgres example: postgresql+psycopg2://user:pass@localhost:5432/autojob
DATABASE_URL=sqlite:///autojob_saas.db

# Redis — Celery broker + rate-limit storage (Phase 5).
REDIS_URL=redis://localhost:6379/0

# Fernet key encrypting per-user secrets at rest (REQUIRED in production).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Uploaded-CV storage: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=storage
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=

# Security
SESSION_COOKIE_SECURE=false        # true behind HTTPS in production
RATELIMIT_STORAGE_URI=memory://    # redis://localhost:6379/1 in production
RATELIMIT_DEFAULT=200 per hour

# Observability
LOG_LEVEL=INFO
LOG_JSON=false
# SENTRY_DSN=
