
# Which config to load: development | testing | production
APP_ENV=development

# ── Core (required in production) ──────────────────────────
# Flask session/CSRF signing key. MUST be stable and secret in production.
SECRET_KEY=dev-insecure-change-me

# Database. MongoDB everywhere — a free Atlas cluster works fine for dev too.
# Include the database name in the path, e.g.:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/autojob
# Blank locally falls back to mongodb://localhost:27017/autojob_dev.
MONGODB_URI=

# Fernet key encrypting each user's SMTP password + API keys at rest.
# Required in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── AI provider (CV tailoring, cover letters, job scoring) ──
# Platform default when a user hasn't picked their own in Settings (or set
# ai_provider on their account). One of: groq | openai | anthropic | gemini |
# grok | openrouter. Groq is the default — free tier, fast — but any of these
# work.
AI_PROVIDER=groq
# Optional model override. Blank uses each provider's own sane default (see
# core/groq_client.py) — only set this if you want a specific model.
AI_MODEL=

# Groq — https://console.groq.com/keys (free tier, no card required).
# Multiple keys supported for rate-limit headroom: GROQ_API_KEY_1, _2, ...
GROQ_API_KEY=

# OpenAI — https://platform.openai.com/api-keys (paid; gpt-4o-mini is cheap).
OPENAI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys (paid;
# claude-3-5-haiku is cheap/fast).
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey (has a free tier;
# gemini-2.0-flash is the default model).
GEMINI_API_KEY=

# xAI Grok — https://console.x.ai (paid; grok-3-mini is the default model).
GROK_API_KEY=

# OpenRouter — https://openrouter.ai/keys (one key, many models/providers —
# some free. Model IDs are provider-prefixed, e.g.
# "meta-llama/llama-3.3-70b-instruct:free" — check openrouter.ai/models for
# what's currently free, and set AI_MODEL explicitly since availability
# changes over time).
OPENROUTER_API_KEY=

# ── CORS (production, split deploy) ────────────────────────
# The deployed frontend's origin (e.g. https://autojob.vercel.app). Required
# in production for the frontend to call this API at all — without it, the
# API accepts same-origin requests only. Comma-separate multiple origins.
# Leave blank locally: the Vite dev server proxies /api same-origin instead.
FRONTEND_ORIGIN=

# Cross-site cookie policy. Defaults to "None" in production (frontend and
# backend are different origins) and "Lax" everywhere else. Override only if
# you're serving both from the same origin behind a shared reverse proxy.
SESSION_COOKIE_SAMESITE=

# ── File storage ───────────────────────────────────────────
# Uploaded CVs + generated packages. 'local' keeps them on disk.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=storage

# ── Optional: platform-managed API key pools ───────────────
# Comma-separated. When set, users who don't bring their own keys fall back to
# these, so they can "just upload a CV". Leave blank to require BYO keys. Each
# is keyed by provider name (MANAGED_<PROVIDER>_KEYS) — only the pool matching
# a user's chosen AI provider is ever used for them.
MANAGED_GROQ_KEYS=
MANAGED_OPENAI_KEYS=
MANAGED_ANTHROPIC_KEYS=
MANAGED_GEMINI_KEYS=
MANAGED_GROK_KEYS=
MANAGED_OPENROUTER_KEYS=
MANAGED_HUNTER_KEYS=
MANAGED_PROSPEO_KEYS=
MANAGED_REOON_KEYS=
MANAGED_MILLION_KEYS=

# ── Optional: scale-out with Celery (advanced) ─────────────
# Default is a single web service with in-process background runs (no Redis).
# To run a separate Celery worker instead, set RUN_VIA_CELERY=true, point
# REDIS_URL at a broker, and run: celery -A autojob.celery_app.celery worker
RUN_VIA_CELERY=false
REDIS_URL=redis://localhost:6379/0

# ── Optional: observability ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=false
# /metrics has no auth by default. Set this to require a matching
# X-Metrics-Token header if the endpoint is reachable from the public internet.
METRICS_TOKEN=
